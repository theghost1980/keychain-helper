{
  "name": "keychain-helper",
  "version": "2.0.1",
  "description": "Zero-dependency TypeScript wrapper for the Hive Keychain browser extension: robust detection, callback and promise APIs, typed responses.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:smoke": "node scripts/smoke-test.mjs",
    "size": "node scripts/size.mjs",
    "prepublishOnly": "npm run typecheck && npm test && npm run build && npm run test:smoke"
  },
  "keywords": [
    "hive",
    "hive-keychain",
    "keychain",
    "blockchain",
    "web3",
    "browser-extension",
    "typescript",
    "zero-dependency"
  ],
  "author": "Saturno Mangieri @theghost1980",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/theghost1980/keychain-helper.git"
  },
  "bugs": {
    "url": "https://github.com/theghost1980/keychain-helper/issues"
  },
  "homepage": "https://github.com/theghost1980/keychain-helper#readme",
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "happy-dom": "21.0.4",
    "tsup": "8.5.1",
    "typescript": "5.9.3",
    "vite": "7.3.8",
    "vitest": "5.0.5"
  }
}
